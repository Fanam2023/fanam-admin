{
  "name": "fanam-pay-web-pwa",
  "scripts": {
    "start": "turbo run start --no-daemon --concurrency=15",
    "dev": "turbo run dev --parallel --no-daemon --concurrency=15",
    "lint": "turbo run lint --parallel --no-daemon --concurrency=15",
    "prepare": "husky install",
    "prettier": "turbo run prettier --parallel --no-daemon --concurrency=15",
    "exports-usage": "turbo run exports-usage --parallel --no-daemon --concurrency=15",
    "eslint": "turbo run eslint --parallel --no-daemon --concurrency=15",
    "styles": "turbo run styles --parallel --no-daemon --concurrency=15",
    "rimraf": "turbo run rimraf --parallel --no-daemon --concurrency=15",
    "fanam-pay": "cd apps/fanam-pay && pnpm dev",
    "fanam-crm": "cd apps/fanam-crm && pnpm dev",
    "fanam-admin": "cd apps/fanam-admin && pnpm dev",
    "build:pay": "cd apps/fanam-pay && pnpm build",
    "build:crm": "cd apps/fanam-crm && pnpm build",
    "build:admin": "cd apps/fanam-admin && pnpm build",
    "start:pay": "cd apps/fanam-pay && pnpm start",
    "start:crm": "cd apps/fanam-crm && pnpm start",
    "start:admin": "cd apps/fanam-admin && pnpm start",
    "build": "pnpm build:pay && pnpm build:crm && pnpm build:admin"
  },
  "devDependencies": {
    "@turbo/gen": "^2.1.1",
    "husky": "^9.1.5",
    "rimraf": "^5.0.10",
    "turbo": "^2.1.1"
  },
  "packageManager": "pnpm@9.0.5",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9.0.5"
  }
}
