{
  "name": "fanam-pay-web-pwa",
  "scripts": {
    "build-dev": "turbo run build-dev --no-daemon --concurrency=15",
    "start": "turbo run start --no-daemon --concurrency=15",
    "dev": "turbo run dev --parallel --no-daemon --concurrency=15",
    "lint": "turbo run lint --parallel --no-daemon --concurrency=15",
    "prepare": "husky install",
    "prettier": "turbo run prettier --parallel --no-daemon --concurrency=15",
    "exports-usage": "turbo run exports-usage --parallel --no-daemon --concurrency=15",
    "eslint": "turbo run eslint --parallel --no-daemon --concurrency=15",
    "styles": "turbo run styles --parallel --no-daemon --concurrency=15",
    "rimraf": "turbo run rimraf --parallel --no-daemon --concurrency=15",
    "care": "cd apps/fanam-care && pnpm dev",
    "assist": "cd apps/fanam-assist && pnpm dev",
    "build:pay": "cd apps/fanam-pay && pnpm build",
    "build:care": "cd apps/fanam-care && pnpm build",
    "build:assist": "cd apps/fanam-assist && pnpm build",
    "build-dev:pay": "cd apps/fanam-pay && pnpm build-dev",
    "build-dev:care": "cd apps/fanam-care && pnpm build-dev",
    "build-dev:assist": "cd apps/fanam-assist && pnpm build-dev",
    "start:pay": "cd apps/fanam-pay && pnpm start",
    "start:care": "cd apps/fanam-care && pnpm start",
    "start:assist": "cd apps/fanam-assist && pnpm start",
    "build:dev": "pnpm build-dev:pay && pnpm build-dev:care && pnpm build-dev:assist",
    "build": "pnpm build:pay && pnpm build:care && pnpm build:assist"
  },
  "devDependencies": {
    "@turbo/gen": "^2.0.4",
    "husky": "^9.0.11",
    "rimraf": "^5.0.7",
    "turbo": "^2.0.4"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9.0.5"
  }
}
