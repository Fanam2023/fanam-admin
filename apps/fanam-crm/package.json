{
  "name": "fanam-crm",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "env-cmd -f ./.env.development next dev --port 3002",
    "build-dev": "env-cmd -f ./.env.staging next build",
    "build": "env-cmd -f ./.env.production next build",
    "start": "next start --port 3002",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "lint": "next lint",
    "exports-usage": "ts-prune",
    "eslint": "eslint \"src/**/*.{ts,tsx}\" --fix --ext .ts,.tsx .",
    "styles": "stylelint \"**/**/*.{sass, scss}\"  --allow-empty-input",
    "rimraf": "rimraf node_modules"
  },
  "private": true,
  "dependencies": {
    "@custom/utils": "workspace:*",
    "@fanam-pkg/core-ui-sass": "^1.0.11",
    "@fanam-pkg/core-utils": "^1.0.3",
    "@tanstack/react-query": "^5.55.4",
    "env-cmd": "^10.1.0",
    "next": "^14.2.9",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@fanam-pkg/eslint": "^1.0.0",
    "@fanam-pkg/prettier": "^1.1.1",
    "@fanam-pkg/style-lint": "^1.0.0",
    "@fanam-pkg/ts-config": "^1.0.0",
    "@types/google.maps": "^3.58.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.5",
    "prettier": "^3.3.3",
    "sass": "^1.78.0",
    "stylelint": "^16.9.0",
    "typescript": "^5.6.2"
  }
}
